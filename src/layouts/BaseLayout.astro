---
import "../styles/global.css";
interface Props {
  lang?: "es" | "en";
  locale?: "es" | "en";
  title: string;
  description?: string;
  canonical?: string;
  alternate?: {
    es?: string;
    en?: string;
  };
  bodyClass?: string;
  skipLinkText?: string;
}

const {
  lang,
  locale,
  title,
  description = "",
  canonical,
  alternate,
  bodyClass = "",
  skipLinkText,
} = Astro.props;
const resolvedLang = lang ?? locale ?? "es";

const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL("https://moonslayers.github.io");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(`${base}og-image.png`, site).toString();
const faviconSvg = `${base}favicon.svg`;
const faviconIco = `${base}favicon.ico`;
---

<!doctype html>
<html lang={resolvedLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {alternate?.es && (
      <link rel="alternate" hreflang="es" href={alternate.es} />
    )}
    {alternate?.en && (
      <link rel="alternate" hreflang="en" href={alternate.en} />
    )}
    <link
      rel="alternate"
      hreflang="x-default"
      href={alternate?.es ?? canonicalUrl}
    />

    <link rel="icon" type="image/svg+xml" href={faviconSvg} />
    <link rel="icon" href={faviconIco} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {skipLinkText && (
      <a href="#main" class="skip-link">
        {skipLinkText}
      </a>
    )}
    <slot />
  </body>
</html>
