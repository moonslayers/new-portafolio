---
interface NavItem {
  href: string;
  label: string;
}

interface Props {
  kicker?: string;
  brand?: string;
  status?: string;
  navLabel?: string;
  nav?: NavItem[];
  items?: NavItem[];
  navItems?: NavItem[];
  class?: string;
}

const {
  kicker,
  brand,
  status,
  navLabel,
  nav,
  items,
  navItems,
  class: className = "",
} = Astro.props;
const resolvedNav = nav ?? items ?? navItems ?? [];
---

<header class={`site-header ${className}`}>
  <div class="site-header__bar">
    {kicker && <span class="site-header__kicker mono">{kicker}</span>}
    <div class="site-header__brand">
      {brand && <span class="site-header__brand-name">{brand}</span>}
      {status && <span class="site-header__status mono">{status}</span>}
    </div>
    <nav class="site-header__nav" aria-label={navLabel}>
      <ul>
        {resolvedNav.map((item) => (
          <li>
            <a href={item.href} class="site-header__link">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <slot name="actions" />
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    backdrop-filter: blur(8px);
    background: color-mix(in srgb, var(--bg-paper) 85%, transparent);
    border-bottom: var(--border-thin);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
  }
  .site-header__kicker {
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-secondary);
  }
  .site-header__brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .site-header__brand-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--ink-primary);
  }
  .site-header__status {
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--success-sage);
  }
  .site-header__nav ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-header__link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    color: var(--ink-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .site-header__link:hover {
    color: var(--ink-primary);
  }
  @media (max-width: 768px) {
    .site-header__nav {
      display: none;
    }
  }
</style>
