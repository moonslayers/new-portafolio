---
import type { Project, Locale } from "../../data/types";
import { getUi } from "../../i18n/ui";
import Card from "./Card.astro";
import Chip from "./Chip.astro";
import p1 from "../../assets/placeholders/project-1.svg";
import p2 from "../../assets/placeholders/project-2.svg";
import p3 from "../../assets/placeholders/project-3.svg";
import p4 from "../../assets/placeholders/project-4.svg";
import p5 from "../../assets/placeholders/project-5.svg";
import p6 from "../../assets/placeholders/project-6.svg";
import { resolveAssetUrl } from "../../lib/assetUrl";

interface Props {
  project?: Project;
  data?: Project;
  item?: Project;
  index?: number;
  locale?: Locale;
  lang?: Locale;
  privateLabel?: string;
  class?: string;
}

const {
  project: projectProp,
  data: dataProp,
  item: itemProp,
  index: indexProp,
  locale: localeProp,
  lang: langProp,
  privateLabel,
  class: className = "",
} = Astro.props;
const project = (projectProp ?? dataProp ?? itemProp)!;
const locale =
  localeProp ?? langProp ?? (Astro.currentLocale as Locale) ?? ("es" as Locale);
getUi(locale);

const placeholders = [p1, p2, p3, p4, p5, p6];
const idx = typeof indexProp === "number" ? indexProp : 0;
const ph = placeholders[idx % placeholders.length] as unknown;
const fallbackSrc =
  typeof ph === "string" ? (ph as string) : (ph as { src: string }).src;
const coverSrc = resolveAssetUrl(project.image?.src, fallbackSrc);
const coverAlt = project.image?.alt ?? `${project.title} — cover`;

const isPrivate = !project.links || project.links.length === 0;
const privateText = privateLabel ?? (locale === "en" ? "Private" : "Privado");

const fieldLabels =
  locale === "en"
    ? { problem: "Problem", decision: "Decision", result: "Result" }
    : { problem: "Problema", decision: "Decisión", result: "Resultado" };

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<Card class={`project-card ${className}`.trim()}>
  <div class="project-card__cover" data-build data-type="image">
    <img
      src={coverSrc}
      alt={coverAlt}
      class="editorial-img w-full h-full object-cover"
      loading="lazy"
      width="640"
      height="360"
    />
    <span class="project-card__cover-label mono" data-build data-type="tag">
      {project.id}
    </span>
  </div>

  <div class="project-card__meta">
    {project.tag && (
      <span class="project-card__tag mono" data-build data-type="tag">
        {project.tag}
      </span>
    )}
    {project.category && (
      <span class="project-card__category mono" data-build data-type="tag">
        {project.category}
      </span>
    )}
  </div>

  <h3 class="project-card__title" data-build data-type="title">
    {project.title}
  </h3>

  {project.role && (
    <p class="project-card__role mono" data-build data-type="body">
      {project.role}
      {project.period ? ` · ${project.period}` : ""}
    </p>
  )}

  <dl class="project-card__fields">
    <div>
      <dt class="project-card__field-label mono" data-build data-type="tag">
        {fieldLabels.problem}
      </dt>
      <dd data-build data-type="body">
        {project.problem}
      </dd>
    </div>
    <div>
      <dt class="project-card__field-label mono" data-build data-type="tag">
        {fieldLabels.decision}
      </dt>
      <dd data-build data-type="body">
        {project.decision}
      </dd>
    </div>
    <div>
      <dt class="project-card__field-label mono" data-build data-type="tag">
        {fieldLabels.result}
      </dt>
      <dd data-build data-type="body">
        {project.result}
      </dd>
    </div>
  </dl>

  {project.stack && project.stack.length > 0 && (
    <div class="project-card__stack">
      {project.stack.map((item) => (
        <Chip>{item}</Chip>
      ))}
    </div>
  )}

  <div class="project-card__links">
    {isPrivate ? (
      <span class="project-card__private mono" data-build data-type="tag">
        {privateText}
      </span>
    ) : (
      project.links!.map((link) => (
        <a
          href={link.href}
          class="project-card__link"
          target={isExternal(link.href) ? "_blank" : undefined}
          rel={isExternal(link.href) ? "noopener noreferrer" : undefined}
          data-build
          data-type="button"
        >
          {link.label}
          {isExternal(link.href) ? " ↗" : ""}
        </a>
      ))
    )}
  </div>
</Card>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .project-card__cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--ink-light);
    border-radius: var(--radius-sm);
    background: var(--ink-light);
    overflow: hidden;
    margin-bottom: 0;
  }
  .project-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .project-card__cover img.editorial-img {
    filter: none;
    mix-blend-mode: normal;
    opacity: 1;
  }
  .project-card__cover img.editorial-img:hover {
    filter: none;
    mix-blend-mode: normal;
    opacity: 1;
  }
  .project-card__cover-label {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 1;
    font-size: 8px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-primary);
    background: rgba(247, 245, 240, 0.92);
    padding: 0.18rem 0.38rem;
    border: 1px solid var(--ink-light);
    border-radius: var(--radius-sm);
    line-height: 1;
  }
  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .project-card__tag {
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent-terracotta);
  }
  .project-card__category {
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-secondary);
  }
  .project-card__title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.15;
    color: var(--ink-primary);
    margin: 0;
  }
  .project-card__role {
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--ink-secondary);
    margin: 0;
  }
  .project-card__fields {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .project-card__fields div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .project-card__field-label {
    font-size: 8px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-secondary);
  }
  .project-card__fields dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--ink-secondary);
  }
  .project-card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.1rem;
  }
  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.4rem;
  }
  .project-card__stack :global(.chip) {
    padding: 0.2rem 0.5rem;
    font-size: 0.62rem;
  }
  .project-card__link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--ink-primary);
    text-decoration: none;
    border: 1px solid var(--ink-light);
    padding: 0.32rem 0.6rem;
    border-radius: var(--radius-sm);
    transition:
      border-color 0.2s ease,
      background 0.2s ease;
  }
  .project-card__link:hover {
    border-color: var(--ink-primary);
    background: rgba(28, 27, 25, 0.03);
  }
  .project-card__private {
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-secondary);
    border: 1px dashed var(--ink-light);
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
  }
</style>
