---
import type { Stack as StackContent, StackGroup } from "../../data/types";
import { getStackIcon, validateStackGroups } from "../../lib/stackIcons";
import SectionHeader from "../ui/SectionHeader.astro";
import TechTile from "../ui/TechTile.astro";

interface Props {
  tag?: string;
  title?: string;
  groups?: StackGroup[];
  stack?: StackContent;
  content?: StackContent;
  data?: StackContent;
  class?: string;
}

const {
  stack: stackProp,
  content: contentProp,
  data: dataProp,
  class: className = "",
  ...rest
} = Astro.props;

const source = (stackProp ?? contentProp ?? dataProp ?? {}) as StackContent;

const tag = rest.tag ?? source.tag;
const title = rest.title ?? source.title ?? "";
const groups = rest.groups ?? source.groups ?? [];

validateStackGroups(groups);
---

<section
  id="stack"
  data-agent-section="stack"
  class={`relative min-h-[100svh] flex items-center py-6 md:py-8 px-6 border-t border-[var(--ink-light)] overflow-x-clip ${className}`.trim()}
>
  <div class="max-w-6xl mx-auto w-full py-2">
    <SectionHeader tag={tag} title={title} />

    {groups.length > 0 && (
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-2 sm:gap-2.5 md:gap-3 mt-3 sm:mt-4">
        {groups.map((group) => (
          <div class="border border-[var(--ink-light)] p-2 sm:p-3 rounded-sm bg-white/30 flex flex-col">
            <h3
              class="mono text-[10px] uppercase tracking-wider text-[var(--ink-secondary)]"
              data-build
              data-type="tag"
            >
              {group.title}
            </h3>
            <ul
              class="mt-2 sm:mt-3 grid grid-cols-2 sm:grid-cols-3 gap-x-1 sm:gap-x-1.5 gap-y-2 sm:gap-y-3"
              role="list"
            >
              {group.items.map((name) => (
                <TechTile name={name} icon={getStackIcon(name) ?? undefined} />
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
